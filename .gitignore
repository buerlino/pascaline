# SPDX-License-Identifier: GPL-3.0-or-later

# Node / web build output
node_modules/
dist/
.vite/
*.tsbuildinfo
test-results/
playwright-report/

# Android build outputs (Capacitor project itself is committed later)
android/**/build/
android/.gradle/
android/local.properties
*.apk
*.aab
*.keystore
*.jks

# Prebuilt third-party binaries: allowed only as spike shortcuts, never committed
spike/**/prebuilt/
spike/prebuilt/

# Engine build trees and downloads (rebuilt from source by engine/*/build-*.sh)
engine/**/_downloads/
engine/**/_build/
engine/**/_out/

# Binaries must never be committed (F-Droid rule); build output dirs are ignored above
*.wasm
*.so
*.a
*.jar
!android/gradle/wrapper/gradle-wrapper.jar

# Editors / OS
.DS_Store
*.swp
.idea/

# Night-shift coordination (locks, device state, messages)
.coord/
# Claude Code: agent worktrees and personal settings
.claude/worktrees/
.claude/settings.local.json
# Python tooling venvs (mpmath oracle etc.)
**/.venv/
spike/**/_build/
spike/**/_out/
# throwaway signing keys for spike release builds
spike/android/_keys/
spike/_ron/
spike/_plot*/
spike/_plotB/

# app/: fonts and engine copied in by npm scripts
app/public/engine/
