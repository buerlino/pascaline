# SPDX-License-Identifier: GPL-3.0-or-later

# Node / web build output
node_modules/
dist/
.vite/
*.tsbuildinfo
test-results/
playwright-report/

# Android build outputs (Capacitor project itself is committed later)
android/**/build/
android/.gradle/
android/local.properties
*.apk
*.aab
*.keystore
*.jks

# Prebuilt third-party binaries: allowed only as spike shortcuts, never committed
spike/**/prebuilt/
spike/prebuilt/

# Engine build trees and downloads (rebuilt from source by engine/*/build-*.sh)
engine/**/_downloads/
engine/**/_build/
engine/**/_out/

# Binaries must never be committed (F-Droid rule); build output dirs are ignored above
*.wasm
*.so
*.a
*.jar

# Editors / OS
.DS_Store
*.swp
.idea/

# Night-shift coordination (locks, device state, messages)
.coord/
# Claude Code: agent worktrees and personal settings
.claude/worktrees/
.claude/settings.local.json
# Python tooling venvs (mpmath oracle etc.)
**/.venv/
spike/**/_build/
spike/**/_out/

# app/: fonts and engine copied in by npm scripts
app/public/engine/

# android/: web assets and config copied in by `npx cap sync`; build outputs; throwaway signing keys
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/_keys/

# android/: no Gradle wrapper (a committed .jar breaks the F-Droid rule); build.sh fetches the pinned Gradle
android/gradle/
android/gradlew
android/gradlew.bat

# MicroPython build downloads and output (rebuilt by python/build-micropython.sh)
python/_downloads/
python/_out/
app/public/python/

# P3 spike: libqalculate build tree, downloads and output (spike/qalc/build-wasm.sh)
spike/qalc/_work/
