+  // Pascaline patch 0025 (G149): b^(n*s/d) (n an integer, d an integer denominator) is ((b^s)^(1/d))^r*(b^s)^q with
+  // n = q*d+r only when (b^s)^(1/d) is b^(s/d), that is when im(s*ln(b)) lies in (-pi,pi] (for a negative b in complex
+  // mode Giac takes (-b)^s and exp(i*pi*s/d), so im(s*ln(-b))); the rule took any b and s, so 2^sqrt(-1-10^-3), Giac's
+  // 2^(10*i*sqrt(10010)/1000), became (2^(10*i*sqrt(10010)))^(1/1000), the principal root of 2^(1000.5*i): another
+  // branch. s = 1 always keeps the rule, whatever b is: arg b lies in (-pi,pi], and an integer power of the principal
+  // root is the principal power (the margin would refuse sqrt(acosh(-1/2)^2) and (-pi)^(3/2) = sqrt(-pi)*(-pi)).
+  // Otherwise decided on the doubles with a margin at the cut, as patch 0018; b or s with no numeric value, or with a
+  // part whose double is not finite, keep the rule. A negative real b with a real s has im(s*ln(b)) = s*pi exactly:
+  // the rule holds for -1 < s < 1 there.
+  static bool pow_double_parts(const gen & g,double & re,double & im){
+    if (g.type==_DOUBLE_){
+      re=g._DOUBLE_val; im=0;
+      return std::isfinite(re);
+    }
+    if (g.type==_CPLX && g._CPLXptr->type==_DOUBLE_ && (g._CPLXptr+1)->type==_DOUBLE_){
+      re=g._CPLXptr->_DOUBLE_val; im=(g._CPLXptr+1)->_DOUBLE_val;
+      return std::isfinite(re) && std::isfinite(im);
+    }
+    return false;
+  }
+
+  static bool pow_root_extract_holds(const gen & b,const gen & s,GIAC_CONTEXT){
+    if (is_one(s))
+      return true;
+    double bre,bim,sre,sim;
+    if (!pow_double_parts(evalf_double(b,1,contextptr),bre,bim) || !pow_double_parts(evalf_double(s,1,contextptr),sre,sim))
+      return true;
+    if (bim==0 && bre>0 && sim==0)
+      return true;
+    if (bre==0 && bim==0)
+      return true;
+    // A negative real b: its double can carry a rounding imaginary part (evalf of (-pi)^3 at Digits > 14), so a b near
+    // the negative axis is tested exactly (Giac's is_real, im(b) = 0); s too, when its double is near the real axis.
+    if (bre<0 && (bim==0 || (std::abs(bim)<=1e-9*std::abs(bre) && b.is_real(contextptr)))){
+      bim=0;
+      if (sim==0 || (std::abs(sim)<=1e-9*std::abs(sre) && s.is_real(contextptr)))
+        return sre>-1+1e-9 && sre<1-1e-9; // im(s*ln(b)) = s*pi
+    }
+    double t=sim*std::log(std::hypot(bre,bim))+sre*std::atan2(bim,bre); // im(s*ln(b))
+    return std::abs(t)<M_PI*(1-1e-9);
+  }
